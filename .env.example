# InfraGuard Agent 환경변수 예시
# `cp .env.example .env` 로 복사한 뒤 값을 채운다 (Windows: copy .env.example .env).
# 주석의 "기본값"은 변수를 비우거나 지웠을 때 코드가 쓰는 값이다.

# Upstage Solar API 키. 필수 — 없으면 LLM 진단이 실패한다 (기본값 없음)
UPSTAGE_API_KEY=
# Solar chat completions 엔드포인트. 기본값: https://api.upstage.ai/v1/solar/chat/completions
UPSTAGE_API_URL=https://api.upstage.ai/v1/solar/chat/completions
# 진단·재검증에 쓰는 모델 이름. 코드 기본값은 solar-pro이고, 이 파일은 solar-pro2로 덮어쓴다
UPSTAGE_MODEL=solar-pro2
# ReAct Loop 최대 반복 횟수(가드레일). 기본값: 10
MAX_LOOP=10
# Prometheus 주소. 기본값: http://localhost:9090
# 백엔드를 컨테이너로 띄우면(docker compose --profile app) compose가 http://prometheus:9090으로 덮어쓴다
PROMETHEUS_URL=http://localhost:9090
# 부하 대상 주소 = nginx 로드밸런서. 기본값: http://localhost:8080
# 백엔드를 컨테이너로 띄우면 compose가 http://nginx:8080으로 덮어쓴다
TARGET_SERVER_URL=http://localhost:8080
# P95 응답 시간 SLO(ms) — 진단 프롬프트의 판단 기준. 기본값: 1000 (근거는 docs/02_알려진이슈.md ISSUE-10)
P95_SLO_MS=1000
# 스케일 가능한 최대 replica 수(가드레일). 기본값: 8
SCALE_MAX_REPLICAS=8
# 디버그 전용 — force_scaling으로 LLM 판단을 덮어쓸 수 있게 한다. 기본값: false
# 발표·측정 시에는 반드시 false로 둔다 (켜면 그 실행의 수치는 발표용으로 쓸 수 없다)
DEBUG_ENDPOINTS_ENABLED=false
